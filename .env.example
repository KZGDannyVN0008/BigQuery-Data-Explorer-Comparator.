# ---------------------------------------------------------------------------
# BigQuery Data Explorer & Comparator — configuration
#
# Copy to .env.local for local development. Every variable below is read on the
# SERVER ONLY. Nothing here is prefixed NEXT_PUBLIC_, so none of it — and no
# credential — is ever sent to the browser.
# ---------------------------------------------------------------------------

# --- Credentials -----------------------------------------------------------
# Authentication uses Application Default Credentials. There is no key file in
# this repo and none should ever be added.
#   Local:      gcloud auth application-default login
#   Cloud Run:  attach a service account; leave GOOGLE_APPLICATION_CREDENTIALS unset.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/adc.json

# Project billed for query jobs. The service account needs bigquery.jobUser here.
GOOGLE_CLOUD_PROJECT=kz-dp-prod

# --- Access control --------------------------------------------------------
# Projects the UI may browse. Anything else is rejected before a query is built.
ALLOWED_PROJECTS=kz-dp-prod,kz-kura

# Region whose INFORMATION_SCHEMA and JOBS views are queried. Must match your
# datasets' location, or lineage and JOIN history come back empty.
BIGQUERY_LOCATION=US

# --- Cost controls ---------------------------------------------------------
# Hard ceiling passed to BigQuery as maximumBytesBilled. A query that would
# exceed it fails at BigQuery rather than running up a bill. 20 GiB.
MAX_BYTES_BILLED=21474836480

# Dry-run estimates above this are refused before the real query is submitted.
DRY_RUN_LIMIT_BYTES=21474836480

# On-demand price per TiB scanned. Display only — it never affects execution.
BQ_USD_PER_TIB=6.25

# Query timeout in milliseconds.
QUERY_TIMEOUT_MS=120000

# --- Result limits ---------------------------------------------------------
# Rows returned to the browser per preview page, and the ceiling a client may
# request. Large result sets are never streamed to the browser.
PREVIEW_PAGE_SIZE=50
PREVIEW_MAX_PAGE_SIZE=200

# Upper bound on the row count a preview reports before it is marked "capped".
PREVIEW_MAX_TOTAL=10000

# Rows in the Sample Data tab.
SAMPLE_ROW_LIMIT=50

# Top-N frequency values computed per profiled column.
TOP_VALUES_LIMIT=10

# --- Comparison ------------------------------------------------------------
# Maximum span, in days, of a comparison window. A date filter is mandatory;
# this caps how wide it may be.
MAX_COMPARE_WINDOW_DAYS=92

# --- Relationships ---------------------------------------------------------
# Days of INFORMATION_SCHEMA.JOBS history mined for lineage and JOIN predicates.
JOIN_HISTORY_DAYS=30

# Curated, human-confirmed relationships. Mounted read-only; the app never writes it.
MANUAL_RELATIONSHIPS_PATH=./config/manual-relationships.json

# --- Development -----------------------------------------------------------
# Serve deterministic fixtures instead of calling BigQuery. Used by the test
# suite and for local UI work without credentials. Never set in production.
# BQ_MOCK=1
